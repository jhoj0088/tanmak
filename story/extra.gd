func ev_laser_cutter(_a) -> void:
	if Game.flag("cut_done"):
		var word := "아직" if Game.flag("cut_0") else ("완벽" if Game.flag("cut_1") else "?")
		await say(["* 레이저 커팅기다. 아까 새긴 명패가 식으면서 나무 냄새가 난다.", "* 명패에는 '%s'." % word])
		return
	await say([
		"* 레이저 커팅기 화면에 작업이 걸려 있다. [ 각인할 문구: CORE WAS HERE ]",
		"* 커서가 깜빡인다. 문구를 바꿀 수 있을 것 같다.",
		"* 옆에 다른 학생들의 명패가 있다. '완성 말고 완료', '오늘도 틀렸다 - 그래도 그렸다'...",
	])
	var i: int = await choose("* 무엇을 새길까?", ["아직 (끝나지 않았다는 뜻)", "완벽 (코어가 좋아할 말)", "? (모르겠다는 뜻)"])
	Game.set_flag("cut_done")
	Game.set_flag("cut_%d" % i)
	match i:
		0:
			Game.emotion += 1
			await say([
				"* 레이저가 천천히 '아직'을 새겼다.",
				"나머지: '아직'은 좋은 말이야. '못 했다'랑 다르잖아. 언젠가는 할 거라는 뜻이니까.",
				"* 감성이 1 올랐다.",
			])
		1:
			Game.logic += 1
			await say([
				"* 레이저가 '완벽'을 새기기 시작했다. 그런데 'ㅂ'의 마지막 획에서 나무가 살짝 탔다.",
				"* 까맣게 그을린 '완벽'이 남았다. 조금도 완벽하지 않다.",
				"나머지: ...푸핫. 이게 더 좋은데?",
				"* 논리가 1 올랐다.",
			])
		_:
			Game.emotion += 1
			await say([
				"* 레이저가 커다란 물음표 하나를 새겼다.",
				"* 벽에 붙은 이름 없는 명패와 나란히 놓으니 꼭 짝 같다.",
				"나머지: 모르겠다는 것도 답이야. 제일 정직한 답.",
				"* 감성이 1 올랐다.",
			])


func ev_art_mirror(_a) -> void:
