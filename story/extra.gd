func ev_piano(_a) -> void:
	if Game.flag("piano_done"):
		await say(["* 피아노가 '반짝반짝 작은 별'을 아주 작게 흥얼거린다.", "* 박자가 조금씩 틀린다. 그래서 더 사람 같다."])
		return
	await say(["* 보면대에 낡은 악보가 펼쳐져 있다. 유치원 학예회용이다.", "* '도 도 솔 솔 ? ? 솔'"])
	var i: int = await choose("* 물음표 자리에 들어갈 음은?", ["미 미", "라 라", "파 파"])
	if i != 1:
		sfx("wrong")
		await say(["* 피아노가 '띵-?' 하고 고개를 갸웃했다.", "나머지: 반짝반짝 작은 별~ 하고 불러 봐. '작은'에서 음이 올라가잖아."])
		return
	sfx("correct")
	await say(["* 피아노가 신이 나서 따라 친다.", "* '파 파 미 미 레 레 ?'"])
	var j: int = await choose("* 마지막 음은?", ["시", "솔", "도"])
	if j != 2:
		sfx("wrong")
		await say(["* 노래가 끝나지 않고 공중에 붕 떴다.", "나머지: 노래는 대개 처음 음으로 돌아와서 끝나. 집에 돌아오듯이."])
		return
	sfx("correct")
	Game.set_flag("piano_done")
	await say([
		"* 반짝반짝 작은 별, 아름답게 비치네.",
		"* 피아노가 끝까지 쳤다. 그러더니 이어서 다른 곡을 치기 시작한다.",
		"* 교가다. 2절에서 또 틀린다. 그래도 멈추지 않고 3절, 4절까지 간다.",
		"나머지: 이 노래, 처음엔 아무도 몰랐대. 1기 선배들이 입학식 날 악보 보면서 처음 불렀대.",
		"나머지: 다 틀렸대. 그래서 다 같이 웃었대.",
		"* 건반 사이에서 무언가 툭 떨어졌다.",
	])
	give("악보 사탕")
	await say(["* '악보 사탕'을 얻었다."])
	await solved("piano")


