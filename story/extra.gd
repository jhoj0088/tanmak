		])


func _letter_lines(n: int) -> Array:
	var lines: Array = [
		"'너에게.'",
		"'안녕. 나 절규야. 편지 쓰는 거 처음이라 어색하다.'",
		"'입학식 날 내 필통 주워 준 거 기억해? 너는 기억 못 하겠지. 나는 기억해.'",
		"'그날 나 집에 가고 싶었거든. 다들 너무 똑똑해 보이고, 나만 캐리어 끌다 넘어지고.'",
		"'근데 네가 필통 주워 주면서 그랬잖아. \"곰 귀엽다.\"'",
		"'그게 다였는데, 그날 나 안 갔어. 그다음 날도 안 갔어.'",
	]
	if n >= 6:
		lines.append("'너는 내가 잃어버린 걸 진짜 많이 찾아 줬어. 세어 보니까 %d개쯤?'" % n)
		lines.append("'(이 편지를 쓸 때보다 늘었을 수도 있어. 나는 계속 잃어버릴 거니까.)'")
	else:
		lines.append("'너는 내가 잃어버린 걸 맨날 찾아 줬어. 셀 수도 없을 만큼.'")
	lines.append_array([
		"'근데 제일 크게 찾아 준 건 물건이 아니야.'",
		"'나 여기 있어도 된다는 거. 그거 찾아 준 거.'",
		"'2학년 되면 내가 너한테 뭐 하나는 꼭 찾아 줄게. 약속.'",
		"'- 맨날 뭐 잃어버리는 절규가'",
		"'추신. 이 편지는 잃어버리지 않게 바로 줄 거임. (아마도)'",
	])
	return lines


