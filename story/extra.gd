const SEQ := [
	{"q": "1, 1, 2, 3, 5, ?", "opts": ["7", "8", "9"], "ans": 1,
		"hint": ["나머지: 바로 앞의 두 수를 봐. 1+1=2, 1+2=3, 2+3=5...", "나머지: 해바라기 씨도, 솔방울도 이 규칙으로 자란대."],
		"ok": ["* 8이 적힌 돌이 떠올랐다. 돌 위에 작은 해바라기가 피어 있다."]},
	{"q": "1, 3, 6, 10, ?", "opts": ["14", "16", "15"], "ans": 2,
		"hint": ["나머지: 차이를 봐. +2, +3, +4... 다음은?", "나머지: 볼링 핀을 삼각형으로 세우는 수랑 같대. 삼각수!"],
		"ok": ["* 15가 적힌 돌이 떠올랐다. 돌들이 삼각형 모양으로 줄을 맞췄다."]},
	{"q": "2, 3, 5, 7, 11, ?", "opts": ["13", "12", "15"], "ans": 0,
		"hint": ["나머지: 이 수들은 1과 자기 자신으로만 나누어떨어져.", "나머지: ...나랑 반대네. 나는 아무것도 나누어떨어지지 않으니까. 하하."],
		"ok": ["* 13이 적힌 돌이 떠올랐다. 소수들이 반짝이며 길을 이었다.", "나머지: 소수는 아무리 가도 끝이 없대. 꼭 '다음'이 있대. 좋지 않아?"]},
]


func ev_seq_gate(a) -> void:
	var q: int = int(a.get("q", 0))
	var d: Dictionary = SEQ[q]
	await say(["* 빈 징검돌 자리 앞에 물안개 같은 문이 떠 있다.", "* [ %s ]" % d["q"]])
	var i: int = await choose("* 빈칸에 올 수는?", d["opts"])
	if i == d["ans"]:
		sfx("correct")
		Game.set_flag("seq_open_%d" % q)
		main.world.refresh_actors()
		await say(d["ok"])
		if Game.flag("seq_open_0") and Game.flag("seq_open_1") and Game.flag("seq_open_2"):
			await solved("sequence")
		return
	sfx("wrong")
	await say(["* 엉뚱한 돌이 떠오르더니 뒤집혔다! 밑에서 무언가 튀어나왔다..."])
	await battle("venn")
	await say(d["hint"])


func ev_forest4_infinity(_a) -> void:
	await say([
		"* 물안개 속에서 누군가 숫자를 세고 있다.",
		"???: 하나, 둘, 셋, ... 구억 구천... 아, 처음부터 다시.",
		"나머지: 무한대야! 끝까지 세려고 하면 영원히 못 끝내는 애.",
		"나머지: 코어가 '모든 수를 다 세어 둬라'고 시켰나 봐. 그게 될 리가 없는데.",
	])
	var r: String = await battle("infinity")
	if r == "spared":
		await say([
			"무한대: ...끝이 없어도 괜찮은 거구나. 세다가 멈춰도 내가 작아지는 게 아니구나.",
			"무한대: 너도 다 못 끝낸 과제가 있지? 그것도 괜찮아. 아직 '다음'이 있다는 뜻이니까.",
			"* 무한대는 ∞ 모양으로 한 번 몸을 꼬더니, 8처럼 일어서서 인사했다.",
		])
	elif r == "killed":
		await say(["* 무한대가 흩어졌다. 숫자가... 어디까지 셌는지 아무도 모른다."])


