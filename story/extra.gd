const ORGANELLE := [
	["* [ 1 / 3 ] 단백질을 합성하는 곳은?", ["핵", "리보솜", "액포"], 1],
	["* [ 2 / 3 ] 유전 정보(DNA)를 주로 보관하는 곳은?", ["핵", "골지체", "리소좀"], 0],
	["* [ 3 / 3 ] 빛에너지로 광합성이 일어나는 곳은?", ["미토콘드리아", "세포막", "엽록체"], 2],
]


func ev_organelle_gate(_a) -> void:
	await say(["* 핵공 모양의 문이다. 문 표면에 세포 지도가 그려져 있다.", "* '세포 속 누가 무슨 일을 하는지 알아야 핵에 들어올 수 있다.'"])
	for q in ORGANELLE:
		var i: int = await choose(q[0], q[1])
		if i != q[2]:
			sfx("wrong")
			await say(["* 문이 '삐-' 소리를 냈다. 막 생겨난 바이러스가 튀어나온다!"])
			await battle("virus")
			await say([
				"나머지: 리보솜은 단백질 공장, 핵은 설계도 보관소, 엽록체는 햇빛 발전소!",
				"나머지: 미토콘드리아는 그 햇빛으로 만든 양분을 태워서 에너지를 내. 헷갈려도 돼. 나도 헷갈려.",
			])
			return
		sfx("correct")
	Game.set_flag("bio4_gate")
	main.world.refresh_actors()
	await say(["* 문이 숨을 쉬듯 부풀었다가 열렸다.", "* 문틈으로 핵 쪽의 따뜻한 빛이 새어 나온다."])
	await solved("organelle")


