## 편광 복도의 문: 단일광자 실험(동시 계수, 헤럴딩) 퀴즈
func ev_polarizer_gate(_a) -> void:
	await say([
		"* 길을 편광 분석기(PA) 세 대가 막고 있다. 옆 칠판에 '단일 광자 실험 - Ch.3 양자 상태, 실험 3'.",
		"* |V> 상태로 준비한 광자 N 개 → PA(±45°) 에서 +45° 출구만 남김 → 다시 PA(H/V).",
		"* '마지막 PA 의 V 출구로 나오는 광자는 평균 몇 개인가?'",
	])
	var i: int = await choose("* V 출구로 나오는 광자 수는?", [
		"N 개 (처음에 V 였으니까 그대로 V)",
		"N/4 개",
		"0 개 (+45° 와 V 는 서로 수직이니까)",
	])
	if i != 1:
		sfx("wrong")
		await say(["* 분석기가 삐익 울리더니 갈 곳을 잃은 광자들이 몰려온다!"])
		await battle("photon")
		await say([
			"나머지: |+45> = (|H> + |V>)/√2 였지? 그럼 H 로 나올 확률도, V 로 나올 확률도 |1/√2|² = 1/2.",
			"나머지: 그리고 첫 PA(±45°)에서 +45° 로 나온 건 N 개 중 절반이야. 처음에 V 였다는 기억은 거기서 지워져.",
		])
		return
	sfx("correct")
	await say([
		"* 분석기 세 대가 차례로 불을 켰다. N → N/2 → N/4.",
		"나머지: 맞아. 가운데 측정이 '나는 V 였다'를 지워 버려. 그래서 다시 반반으로 갈라지는 거야.",
		"* 이번엔 검출기 세 대가 떠오른다. G, T, R. 화면: 'G∧T: 4,410  G∧R: 4,395  G∧T∧R: 3'",
		"* '게이트 G 가 울린 광자(헤럴드된 단일 광자)를 빔 분할기에 보냈다. T 와 R 에서 잰 g(2)(0) 은?'",
	])
	var j: int = await choose("* g(2)(0) 은?", [
		"1 이상 (빛은 파동이니 T 와 R 이 함께 울린다)",
		"1 보다 훨씬 작다 (약 0.018. 광자는 T 나 R 중 한 곳으로만 간다)",
		"정확히 0.5",
	])
	if j != 1:
		sfx("wrong")
		await say([
			"* 검출기가 고개를 갸웃했다.",
			"나머지: 고전적인 파동이면 g(2)(0) ≥ 1 이어야 해. 빔 분할기에서 반씩 나뉘어 둘 다 울리니까.",
			"나머지: 그런데 화면을 봐. G∧T∧R 이 고작 3 이야. 광자 하나는 쪼개지지 않아. 투과하거나, 반사하거나.",
		])
		return
	sfx("correct")
	Game.set_flag("optics3_gate")
	main.world.refresh_actors()
	await say([
		"* 검출기 세 대가 동시에 '딸깍' 하고 비켜섰다.",
		"나머지: 수업 때 논문(Thorn 외, 2004)에서도 0.0177 이 나왔지. 고전 부등식 g(2)(0) ≥ 1 을 크게 어긴 거야.",
		"나머지: 게이트가 '하나 왔어' 하고 알려 주면, 그 하나는 정말 하나야. 반으로 나뉘지 않아.",
		"나머지: ...너랑 나도 그런 거면 좋겠다. 네가 있다는 걸 내가 알려 주는 거.",
	])
	await solved("polarizer")


