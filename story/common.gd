# ---------------------------------------------------------------- 5층 이스터에그
## 수학 교원연구실의 숨은 보스
func ev_redpen(_a) -> void:
	await say([
		"* 불 꺼진 교무실, 한 책상에만 스탠드가 켜져 있다. 크고 동그란 빨간 안경이 번쩍인다.",
		"GIL: ...이 시간에 교무실에 들어온 학생이 누구죠?",
		"GIL: 마침 잘됐네요. 채점할 답안지가 부족했거든요.",
	])
	var i: int = await choose("* 어떻게 할까?", ["답안지인 척한다 (싸운다)", "조용히 뒷걸음질 친다"])
	if i == 1:
		await say(["* 당신은 못 본 척 물러났다.", "GIL: 흥. 다음 시험 때 봐요."])
		return
	var r: String = await battle("redpen")
	if r == "fled":
		await say(["* 간신히 도망쳤다... GIL은 아직 그 자리에 있다."])
		return
	Game.set_flag("redpen_done")
	if r == "spared":
		Game.set_flag("redpen_spared")
		main.world.refresh_actors()
		await say(["GIL: ...오랜만에 선생 노릇을 한 기분이에요.", "* (숨은 보스를 설득했다!)"])
	else:
		Game.set_flag("redpen_killed")
		main.world.refresh_actors()
		await say(["* 교무실이 조용해졌다. 바닥에 빨간 잉크 얼룩만 남았다."])


func ev_telescope(_a) -> void:
	if Game.flag("got_star_candy"):
		await say(["* 600mm 주망원경이다.", "* 렌즈 너머의 누군가는 이제 보이지 않는다."])
		return
	Game.set_flag("got_star_candy")
	await say([
		"* 600mm 주망원경이다. 세종시에서 가장 멀리 보는 눈.",
		"* 들여다보니... 별 하나가 이쪽으로 손을 흔든다.",
		"* 깜짝 놀라 눈을 떼자, 접안렌즈에 무언가 붙어 있다.",
	])
	give("별사탕")
	sfx("heal")
	await say(["* '별사탕'을 얻었다."])


func ev_printer3d(_a) -> void:
	if Game.flag("got_spaghetti"):
		await say(["* 3D 프린터가 열심히 무언가를 뽑고 있다.", "* 이번에도 스파게티가 될 것 같다."])
		return
	Game.set_flag("got_spaghetti")
	await say([
		"* 3D 프린터가 혼자 돌아가고 있다.",
		"* 출력물이 베드에서 떨어져 플라스틱 스파게티가 되어 있다.",
	])
	give("출력 실패작")
	await say(["* '출력 실패작'을 얻었다. (왜 주웠을까?)"])


func ev_jokbo(_a) -> void:
	if Game.flag("got_jokbo"):
		await say(["* 족보가 있던 사물함이다. 이제 비어 있다."])
		return
	await say(["* 이 사물함만 살짝 열려 있다.", "* 안에 '수학 기출 족보 (대대로 전해짐)'이라고 적힌 공책이 있다."])
	var i: int = await choose("* 읽어 볼까?", ["읽는다", "남의 것이니 덮는다"])
	Game.set_flag("got_jokbo")
	if i == 0:
		Game.logic += 1
		await say(["* 족보를 훑어보았다. 대우, 귀류법, 귀납법... 감이 온다.", "* 논리가 1 올랐다."])
	else:
		Game.emotion += 1
		await say(["* 당신은 공책을 덮고 사물함을 닫아 주었다.", "* 감성이 1 올랐다."])
