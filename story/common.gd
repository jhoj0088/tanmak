## 세이브 포인트(★)를 조사했을 때
func ev_save_point(_a) -> void:
	Game.hp = Game.max_hp
	save()
	sfx("save")
	var room: String = main.world.room_id if main.world else ""
	var flavor: Array = SAVE_FLAVOR.get(room, ["* 작은 별빛이 따뜻하게 빛난다."])
	await say(flavor + ["* (HP가 모두 회복되었다. 저장했다.)"])
	# 별마다 한 번씩, 나머지와 나누는 이야기
	if TALKS.has(room) and not Game.flag("talk_" + room) and Game.flag("met_namoji"):
		var i: int = await choose("* 나머지가 명찰 뒤에서 꼼지락거린다.", ["이야기를 나눈다", "다음에"])
		if i == 0:
			Game.set_flag("talk_" + room)
			await say(TALKS[room])


