static func item(id: String) -> Dictionary:
	return ITEMS.get(id, {"name": id, "desc": "", "found": [], "return": []})


## 주웠지만 아직 돌려주지 않은 물건들
static func carried() -> Array:
	var out: Array = []
	for id in ORDER:
		if Game.flag("jk_found_" + id) and not Game.flag("jk_back_" + id):
			out.append(id)
	return out


static func returned_count() -> int:
	var n := 0
	for id in ORDER:
		if Game.flag("jk_back_" + id):
			n += 1
	return n
